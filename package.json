{
  "name": "vencord-pgp",
  "version": "1.0.0",
  "description": "Vencord userplugin: automatic OpenPGP encryption for Discord DMs and group DMs. Testable crypto core plus the Vencord adapter.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "vencord",
    "discord",
    "openpgp",
    "pgp",
    "encryption",
    "privacy",
    "plugin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "testTsc": "tsc --noEmit",
    "test:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-installer.ps1",
    "lint": "node scripts/check-no-secrets.mjs",
    "wiki:build": "node scripts/build-wiki.mjs",
    "wiki:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-wiki.ps1"
  },
  "dependencies": {
    "openpgp": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "typescript": "^5.6.0"
  }
}

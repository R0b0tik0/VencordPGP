# Normalize text files to LF in the repository, but keep Windows scripts CRLF.
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.txt text eol=crlf

*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Prebuilt installer payload: keep exact bytes; manifest.sha256 hashes them.
installer/payload/** -text
